# Django
DEBUG=False
SECRET_KEY=replace-me-with-a-50-char-random-string
ALLOWED_HOSTS=bookishbailee.com,www.bookishbailee.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://bookishbailee.com,https://www.bookishbailee.com
DJANGO_ADMIN_URL=bb-admin/

# Public hostname Caddy uses for ACME and the reverse_proxy site block
DOMAIN=bookishbailee.com

# Database — sqlite default works locally; postgres for prod / docker
# DATABASE_URL=sqlite:///db.sqlite3
DATABASE_URL=postgres://bailee:bailee@db:5432/bailee

# Postgres (used by docker compose db service)
POSTGRES_USER=bailee
POSTGRES_PASSWORD=bailee
POSTGRES_DB=bailee

# Optional local-only Caddy host port overrides (leave commented in prod)
# CADDY_HTTP_PORT=8080
# CADDY_HTTPS_PORT=8443
