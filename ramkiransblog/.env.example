# Django
DEBUG=False
SECRET_KEY=replace-me-with-a-50-char-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
DJANGO_ADMIN_URL=rk-admin/

# Public site URL — used in robots.txt's Sitemap: line and as a fallback for
# absolute URL building. Set to the production HTTPS URL on the VM.
SITE_URL=http://localhost:8000

# Resend transactional email (subscriber double-opt-in + unsubscribe).
# Get your API key at https://resend.com/api-keys. Leave blank in dev to
# skip actual sending; signup still creates Subscriber rows.
RESEND_API_KEY=
# Until your domain is verified at Resend, use onboarding@resend.dev
# (sandbox; only sends to your account's verified test email).
RESEND_FROM_EMAIL=Ram Chevendra <onboarding@resend.dev>
# Optional: where replies go (Resend doesn't accept inbound mail).
RESEND_REPLY_TO=
# Physical address shown in email footers (CAN-SPAM compliance for broadcasts).
MAIL_PHYSICAL_ADDRESS=

# Database — sqlite default works locally; postgres for prod / docker
# DATABASE_URL=sqlite:///db.sqlite3
DATABASE_URL=postgres://blog:blog@db:5432/blog

# Postgres (used by docker compose db service)
POSTGRES_USER=blog
POSTGRES_PASSWORD=blog
POSTGRES_DB=blog

# Optional local-only Caddy host port overrides (leave commented in prod)
# CADDY_HTTP_PORT=8080
# CADDY_HTTPS_PORT=8443
